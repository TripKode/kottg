// KSP-3 Gate 5: KLPFactory — crea pools CPV on-chain vía el opcode CREATE.
// Generado por scripts/gen_factory.py: embebe el bytecode del CPV y del KLP
// (KVI KSP-1). Cada createPool():
//   1) CREATE del pool CPV (dirección wallet-scheme: QSH(factory‖nonce))
//   2) CREATE del KLP (KVI — el token de posición del pool)
//   3) init del pool con (tokenA, tokenB, klp) — el pool se registra como
//      minter del KLP usando su identidad (self.address)
// El nonce de CREATE vive en un slot reservado del storage de la factory
// (journalado: revert del frame también revierte el nonce).
contract KLPFactory {
    state:
        gov: address
        poolCount: u256
        pools: map[u256, address]

    init(govAddr: address) {
        self.gov = govAddr
        self.poolCount = 0
    }

    require fn onlyGov() {
        assert(msg.sender == self.gov, "Factory: solo gov")
    }

    pub fn createPool(tokenA: address, tokenB: address) -> address onlyGov {
        // KVM-3: deploy directo — sin ejecución al crear; inicialización
        // explícita via CALL a continuación.
        let pool = ext.create("")
        let klp = ext.create("")

        // init del pool (void: el 0 del retorno se ignora — ext.call ya
        // revierte si la llamada falla). Dentro, el pool hace
        // klp.init(self.address) registrándose como minter del KLP.
        let okInit = ext.call(pool, "init(address,address,address)", tokenA, tokenB, klp)

        let idx = self.poolCount
        self.pools[idx] = pool
        self.poolCount += 1
        return pool
    }

    view fn poolAt(i: u256) -> address {
        return self.pools[i]
    }

    view fn numPools() -> u256 {
        return self.poolCount
    }
}
