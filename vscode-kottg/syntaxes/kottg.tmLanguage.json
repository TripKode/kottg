{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Kottg",
    "scopeName": "source.kottg",
    "patterns": [
        {"include": "#comments"},
        {"include": "#keywords"},
        {"include": "#storage-types"},
        {"include": "#primitive-types"},
        {"include": "#strings"},
        {"include": "#numbers"},
        {"include": "#functions"},
        {"include": "#operators"},
        {"include": "#constants"},
        {"include": "#identifiers"}
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.kottg",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.kottg",
                    "begin": "/\\*",
                    "end": "\\*/"
                },
                {
                    "name": "comment.block.documentation.kottg",
                    "begin": "///",
                    "end": "$"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.kottg",
                    "match": "\\b(if|else|while|loop|in|match|return|break|continue|as)\\b"
                },
                {
                    "name": "keyword.declaration.kottg",
                    "match": "\\b(contract|state|init|fn|pub|priv|view|require|event|struct|enum)\\b"
                },
                {
                    "name": "keyword.other.kottg",
                    "match": "\\b(let|mut|self|emit)\\b"
                },
                {
                    "name": "keyword.control.exception.kottg",
                    "match": "\\b(assert|require|revert|try|catch)\\b"
                }
            ]
        },
        "storage-types": {
            "patterns": [
                {
                    "name": "storage.type.kottg",
                    "match": "\\b(vec|map|array)\\b"
                }
            ]
        },
        "primitive-types": {
            "patterns": [
                {
                    "name": "storage.type.primitive.kottg",
                    "match": "\\b(bool|u8|u16|u32|u64|u128|u256|i8|i16|i32|i64|i128|i256|address|hash|bytes|string)\\b"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.kottg",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.kottg",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.hex.kottg",
                    "match": "\\b0[xX][0-9a-fA-F]+\\b"
                },
                {
                    "name": "constant.numeric.decimal.kottg",
                    "match": "\\b[0-9]+\\b"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "entity.name.function.kottg",
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.arithmetic.kottg",
                    "match": "\\+|\\-|\\*|\\/|%|\\+=|\\-=|\\*=|\\/=|%="
                },
                {
                    "name": "keyword.operator.comparison.kottg",
                    "match": "==|!=|<|>|<=|>="
                },
                {
                    "name": "keyword.operator.logical.kottg",
                    "match": "&&|\\|\\||!"
                },
                {
                    "name": "keyword.operator.assignment.kottg",
                    "match": "="
                },
                {
                    "name": "keyword.operator.other.kottg",
                    "match": "->|\\.\\.|:"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.boolean.kottg",
                    "match": "\\b(true|false)\\b"
                },
                {
                    "name": "variable.language.kottg",
                    "match": "\\b(msg|block|tx|precompiled)\\b"
                },
                {
                    "name": "support.variable.property.kottg",
                    "match": "\\b(sender|value|data|gas|number|timestamp|validator|origin|gasprice|address|balance)\\b"
                },
                {
                    "name": "keyword.other.special-method.kottg",
                    "match": "\\b(indexed)\\b"
                }
            ]
        },
        "identifiers": {
            "patterns": [
                {
                    "name": "variable.other.kottg",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
                }
            ]
        }
    }
}
